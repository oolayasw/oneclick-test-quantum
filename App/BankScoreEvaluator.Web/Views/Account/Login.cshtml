@model BankScoreEvaluator.Web.Models.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesion";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Score Bancario - Login</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background: #1f2937; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .login-card { background: #fff; padding: 40px; border-radius: 12px; width: 380px; box-shadow: 0 10px 40px rgba(0,0,0,.4); }
        .login-card h2 { text-align: center; margin-bottom: 6px; color: #1f2937; }
        .login-card p.subtitle { text-align: center; color: #6b7280; margin-bottom: 24px; font-size: .9rem; }
        .btn-login { width: 100%; background: #1f2937; color: #fff; border: none; padding: 10px; border-radius: 8px; font-size: 1rem; }
        .btn-login:hover { background: #374151; }
        .hint { font-size: .78rem; color: #9ca3af; margin-top: 14px; text-align: center; }
    </style>
</head>
<body>
    <div class="login-card">
        <h2>Score Bancario</h2>
        <p class="subtitle">Evaluador de riesgo crediticio</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input asp-for="Username" class="form-control" placeholder="ej: admin" autocomplete="off" />
            </div>
            <div class="mb-3">
                <label class="form-label">Contrasena</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="********" />
            </div>
            <button type="submit" class="btn-login">Ingresar</button>
        </form>

        <p class="hint">
            Usuarios fake: admin / analista / supervisor<br />
            Contrasenas en texto plano (mala practica).
        </p>
    </div>
</body>
</html>
