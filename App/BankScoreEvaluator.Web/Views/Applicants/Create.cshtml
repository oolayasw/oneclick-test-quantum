@model BankScoreEvaluator.Web.Models.Applicant
@{
    ViewData["Title"] = "Registrar Solicitante";
}

<h2>Registrar Solicitante</h2>
<p class="text-muted">Ingrese los datos del solicitante para la evaluacion de score.</p>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label>Nombre completo</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label>Documento</label>
                    <input asp-for="Document" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label>Email</label>
                    <input asp-for="Email" class="form-control" type="email" required />
                </div>
                <div class="col-md-6">
                    <label>Edad</label>
                    <input asp-for="Age" class="form-control" type="number" required />
                </div>
                <div class="col-md-6">
                    <label>Ingreso mensual ($)</label>
                    <input asp-for="MonthlyIncome" class="form-control" type="number" step="0.01" required />
                </div>
                <div class="col-md-6">
                    <label>Gastos mensuales ($)</label>
                    <input asp-for="MonthlyExpenses" class="form-control" type="number" step="0.01" required />
                </div>
                <div class="col-md-6">
                    <label>Deuda total ($)</label>
                    <input asp-for="TotalDebt" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-6">
                    <label>Meses de historial crediticio</label>
                    <input asp-for="CreditHistoryMonths" class="form-control" type="number" />
                </div>
                <div class="col-md-6">
                    <label>Numero de prestamos activos</label>
                    <input asp-for="NumberOfLoans" class="form-control" type="number" />
                </div>
                <div class="col-md-6">
                    <label>Tipo de empleo</label>
                    <select asp-for="EmploymentType" class="form-control">
                        <option>Dependiente</option>
                        <option>Independiente</option>
                        <option>Pensionado</option>
                        <option>Sin empleo</option>
                    </select>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="HasPreviousDefault" class="form-check-input" type="checkbox" />
                        <label class="form-check-label">Tiene mora o incumplimiento previo</label>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-success">Guardar solicitante</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
